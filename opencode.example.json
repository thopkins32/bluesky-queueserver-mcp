{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "bluesky-queueserver": {
      "type": "local",
      "command": ["pixi", "run", "serve"],
      "environment": {
        "QSERVER_HTTP_SERVER_URI": "http://localhost:60610",
        "QSERVER_HTTP_API_KEY": "{env:QSERVER_HTTP_API_KEY}",
        "QSERVER_USER_GROUP": "primary"
      },
      "enabled": true
    }
  }
}
